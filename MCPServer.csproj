<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Keerukee.MCPServer.Stdio</PackageId>
    <Version>1.0.3</Version>
    <Authors>Keerthi RB</Authors>
    <PackageReleaseNotes>v1.0.3: Added MCP 2026-07-28 server/discover support, multi-version initialize negotiation, top-level JSON-RPC 2.0 error responses, async tool/resource/prompt handlers, and UTF-8 stdio encoding</PackageReleaseNotes>
    <Description>A lightweight library for building MCP (Model Context Protocol) servers in .NET without external dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/keerukee/MCPServer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/keerukee/MCPServer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\workflows\publish.yml" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
